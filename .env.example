# Public URL of the site, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://jboxdsign.vercel.app

# ── Contact form email (Resend API, free plan) ──────────────────────────────
# Every inquiry is emailed to CONTACT_TO_EMAIL (default: info@jboxidsign.com).
# Resend free plan: 100 emails/day, 3,000/month. API Keys → Create API Key (Sending access).
# Resend delivers to info@jboxidsign.com only if EITHER your Resend account email is
# info@jboxidsign.com, OR you verify jboxidsign.com under Resend → Domains (recommended), and
# then set CONTACT_FROM_EMAIL to an address on it, e.g. JBOX iDsign Website <website@jboxidsign.com>.
# Without RESEND_API_KEY: development only logs inquiries; production shows visitors an
# error with the phone/email instead of pretending the message was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@jboxidsign.com
# Optional. Default: JBOX iDsign Website <onboarding@resend.dev> (works without a domain).
CONTACT_FROM_EMAIL=

# ── Cloudflare Turnstile (spam/bot check before any email is sent) ──────────
# Create a widget at https://dash.cloudflare.com → Turnstile, add your domain(s) and localhost.
# Test keys for local development (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The site key is baked in at build time, so rebuild after changing it.
# Without a secret key: development skips the check; production refuses to send.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional preview password gate ──────────────────────────────────────────
# The site is public. Set SITE_GATE=on only to put it back behind a password
# (e.g. while previewing a redesign). The password is not stored in the repo.
# SITE_GATE=on
# SITE_PASSWORD=           # override the preview password (host env only, never commit)
